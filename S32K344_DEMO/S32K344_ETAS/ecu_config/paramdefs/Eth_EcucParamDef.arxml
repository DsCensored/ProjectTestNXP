              <CONTAINERS>
                <!-- Container Definition: EthConfigSet -->
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5038b196-90f1-4b1e-991a-59d361bf33c9">
                  <SHORT-NAME>EthConfigSet</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This container contains the configuration parameters and sub containers of the AUTOSAR Eth module.</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00015</RELATED-TRACE-ITEM-REF>
