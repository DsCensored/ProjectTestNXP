                      <PARAMETERS>
                        <!-- PARAMETER DEFINITION: EthCtrlConfigSwBufferHandling -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e01d00f0-691e-42a0-91ab-7779600e6944">
                          <SHORT-NAME>EthCtrlConfigSwBufferHandling</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables / Disables SW buffer management</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Eth_00071</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
