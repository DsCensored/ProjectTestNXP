                  <SUB-CONTAINERS>
                    <!-- Container Definition: EthCtrlConfig -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:56cd8c81-2738-4e37-9187-eb8d6838c4c6">
                      <SHORT-NAME>EthCtrlConfig</SHORT-NAME>
                      <DESC>
