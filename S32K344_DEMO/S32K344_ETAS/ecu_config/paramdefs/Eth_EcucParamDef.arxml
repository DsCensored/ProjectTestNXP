                        </ECUC-BOOLEAN-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: EthCtrlEnableOffloadChecksumUDP -->
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f386414c-101f-4f4f-8838-41b35cfe74c7">
                          <SHORT-NAME>EthCtrlEnableOffloadChecksumUDP</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables / Disables hardware offloading for UDP checksums.</L-2>
                          </DESC>
