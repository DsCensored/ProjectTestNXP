<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd">
  <ADMIN-DATA>
    <DOC-REVISIONS>
      <DOC-REVISION>
        <ISSUED-BY>RB</ISSUED-BY>
        <DATE>2022-05-05</DATE>
      </DOC-REVISION>
    </DOC-REVISIONS>
  </ADMIN-DATA>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>RB</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>RBA</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>rba_Dfa</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>EcucModuleDefs</SHORT-NAME>
                  <ELEMENTS>
                    <!-- Module Definition: rba_Dfa -->
                    <ECUC-MODULE-DEF>
                      <SHORT-NAME>rba_Dfa</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="EN">MCAL DFA Modelling Unit</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="EN">Configuration of the MCAL module for the DFA (data flow architecture) modelling unit.</L-2>
                      </DESC>
                      <CATEGORY>VENDOR_SPECIFIC_MODULE_DEFINITION</CATEGORY>
                      <ADMIN-DATA>
                        <DOC-REVISIONS>
                          <DOC-REVISION>
                            <REVISION-LABEL>5.1.0</REVISION-LABEL>
                            <ISSUED-BY>RB</ISSUED-BY>
                            <DATE>2021-09-20</DATE>
                          </DOC-REVISION>
                        </DOC-REVISIONS>
                      </ADMIN-DATA>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
                      <SUPPORTED-CONFIG-VARIANTS>
                        <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                      </SUPPORTED-CONFIG-VARIANTS>
                      <CONTAINERS>
                        <!-- Container Definition: rba_DfaConfigSet -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF>
                          <SHORT-NAME>rba_DfaConfigSet</SHORT-NAME>
                          <LONG-NAME>
                            <L-4 L="EN">Configuration data set</L-4>
                          </LONG-NAME>
                          <DESC>
                            <L-2 L="EN">This is the base container that contains the post-build selectable configuration parameters</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <SUB-CONTAINERS>
                            <!-- Container Definition: rba_DfaFFTCalculations -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF>
                              <SHORT-NAME>rba_DfaFFTCalculations</SHORT-NAME>
                              <LONG-NAME>
                                <L-4 L="EN">FFT Calculation</L-4>
                              </LONG-NAME>
                              <DESC>
                                <L-2 L="EN">This is the container for the FFT algorithm specific parameters.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: rba_DfaFFTCalculationMode -->
                                <ECUC-ENUMERATION-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaFFTCalculationMode</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">Calculation Mode</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">&lt;BR&gt; Select in which mode this Model is to be calculated:
A: Synchronous
B: Asynchronous</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_CALCULATION_MODE_FFT_SYNC</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Synchronous</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_CALCULATION_MODE_FFT_ASYNC</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Asynchronous</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: rba_DfaFFTDimension -->
                                <ECUC-INTEGER-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaFFTDimension</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">Dimension</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">Size of the Vector (log2).</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>11</MAX>
                                  <MIN>7</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: rba_DfaFFTInputType -->
                                <ECUC-ENUMERATION-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaFFTInputType</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">InputType</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">This parameter specifies the Input Type:<BR/>
Real: Only a Real Input Vector should be provided.<BR/>
Complex: Real and Imag. Vectors should be provided.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_INPUT_TYPE_COMPLEX_E</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Complex</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_INPUT_TYPE_REAL_E</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Real</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: rba_DfaFFTNumberType -->
                                <ECUC-ENUMERATION-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaFFTNumberType</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">NumberType</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">This parameter specifies the Data Type of the Numbers.<BR/>
Currently only float32 is supported.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_INPUT_DATA_TYPE_FLOAT32_E</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">float32</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_INPUT_DATA_TYPE_INTEGER_E</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Integer</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: rba_DfaFFTOutputType -->
                                <ECUC-ENUMERATION-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaFFTOutputType</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">OutputType</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">This parameter specifies the length of the resulting spectrum and whether the spectrum should be normalized.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_SPECTRUM_NORM_FULL_E</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Full Normalised</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_SPECTRUM_NORM_HALF_E</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Half Normalised</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_SPECTRUM_NATIVE_FULL_E</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Full Native</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_SPECTRUM_NATIVE_HALF_E</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Half Native</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <!-- Container Definition: rba_DfaMultilayerPerceptron -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF>
                              <SHORT-NAME>rba_DfaMultilayerPerceptron</SHORT-NAME>
                              <LONG-NAME>
                                <L-4 L="EN">MultilayerPerceptron</L-4>
                              </LONG-NAME>
                              <DESC>
                                <L-2 L="EN">This is the container for the Gaussian RBF model specific parameters.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: rba_DfaMultilayerPerceptronCalculationMode -->
                                <ECUC-ENUMERATION-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaMultilayerPerceptronCalculationMode</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">Calculation Mode</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">&lt;BR&gt; Select in which mode this MultilayerPerceptron is to be calculated:
A: Synchronous
B: Asynchronous</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_CALCULATION_MODE_MULTILAYERPERCEPTRON_SYNC</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Synchronous</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_CALCULATION_MODE_MULTILAYERPERCEPTRON_ASYNC</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Asynchronous</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: rba_DfaMultilayerPerceptronName -->
                                <ECUC-STRING-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaMultilayerPerceptronName</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">MultilayerPerceptron name</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">&lt;BR&gt;Name of the model data to be used.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB:0.7.0:2013-05-14</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                      <MAX-LENGTH>30</MAX-LENGTH>
                                      <MIN-LENGTH>1</MIN-LENGTH>
                                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                                </ECUC-STRING-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <!-- Container Definition: rba_Dfa_GaussModels -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF>
                              <SHORT-NAME>rba_Dfa_GaussModels</SHORT-NAME>
                              <LONG-NAME>
                                <L-4 L="EN">Gaussian Model</L-4>
                              </LONG-NAME>
                              <DESC>
                                <L-2 L="EN">This is the container for the Gaussian RBF model specific parameters.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                              <PARAMETERS>
                                <!-- PARAMETER DEFINITION: rba_DfaModelCalculationMode -->
                                <ECUC-ENUMERATION-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaModelCalculationMode</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">Calculation Mode</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">&lt;BR&gt; Select in which mode this Model is to be calculated:
A: Synchronous
B: Asynchronous</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_CALCULATION_MODE_GAUSSIAN_RBF_SYNC</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Synchronous</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>RBA_DFA_CALCULATION_MODE_GAUSSIAN_RBF_ASYNC</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Asynchronous</L-4>
                                      </LONG-NAME>
                                      <ORIGIN>RB</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: rba_DfaModelDataDimension -->
                                <ECUC-INTEGER-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaModelDataDimension</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">Model Dimension</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">Dimension of the AMU Model</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB:0.7.0:2013-05-14</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>32</MAX>
                                  <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: rba_DfaModelDataName -->
                                <ECUC-STRING-PARAM-DEF>
                                  <SHORT-NAME>rba_DfaModelDataName</SHORT-NAME>
                                  <LONG-NAME>
                                    <L-4 L="EN">Model data name</L-4>
                                  </LONG-NAME>
                                  <DESC>
                                    <L-2 L="EN">&lt;BR&gt;Name of the model data to be used.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>RB:0.7.0:2013-05-14</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <ECUC-STRING-PARAM-DEF-VARIANTS>
                                    <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                      <MAX-LENGTH>30</MAX-LENGTH>
                                      <MIN-LENGTH>1</MIN-LENGTH>
                                    </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                  </ECUC-STRING-PARAM-DEF-VARIANTS>
                                </ECUC-STRING-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: rba_DfaGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF>
                          <SHORT-NAME>rba_DfaGeneral</SHORT-NAME>
                          <LONG-NAME>
                            <L-4 L="EN">General settings</L-4>
                          </LONG-NAME>
                          <DESC>
                            <L-2 L="EN">Container with general configuration (parameters) of the Dfa Driver software module.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <PARAMETERS>
                            <!-- PARAMETER DEFINITION: rba_DfaDevErrorDetect -->
                            <ECUC-BOOLEAN-PARAM-DEF>
                              <SHORT-NAME>rba_DfaDevErrorDetect</SHORT-NAME>
                              <LONG-NAME>
                                <L-4 L="EN">Development error detection</L-4>
                              </LONG-NAME>
                              <DESC>
                                <L-2 L="EN">Enables/disables the detection and notification of development errors. If this parameter is enabled, then extended error checking is performed during runtime; any errors detected by these checks are reported to the Det module. This feature should be switched off in series software.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <ORIGIN>RB</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <!-- PARAMETER DEFINITION: rba_DfaMonLvl -->
                            <ECUC-INTEGER-PARAM-DEF>
                              <SHORT-NAME>rba_DfaMonLvl</SHORT-NAME>
                              <LONG-NAME>
                                <L-4 L="EN">Monitoring level</L-4>
                              </LONG-NAME>
                              <DESC>
                                <L-2 L="EN">Selection of the monitoring level for the calculation time:<BR/>
0: Monitoring is disabled (default)<BR/>
1: Common monitoring</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>RB</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0</DEFAULT-VALUE>
                              <MAX>1</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </CONTAINERS>
                    </ECUC-MODULE-DEF>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
